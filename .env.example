# Application Configuration
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Redis Feature Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB Ingestion Buffer
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=spotq_eta_db

# Machine Learning Model Artifacts
MODEL_PATH=app/infrastructure/ml_models/artifacts/eta_model_v1.json

# S3 Artifact Storage & Model Registry (SCRUM-1228)
AWS_S3_BUCKET=spotq-restaurant-files
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_ARTIFACT_PREFIX=ml-models/eta
ETA_MODEL_ADMIN_KEY=change-this-to-a-secure-32-character-secret-key-123456
